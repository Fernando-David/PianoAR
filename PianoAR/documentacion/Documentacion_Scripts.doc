    </tr>
</table>

<div class="warn-box"><strong>¿Qué NO se debe modificar en <code>GestorMenu</code>?:</strong> La convención de nombres de archivos. <code>SeleccionarCancion</code> busca audios en <code>"Audios/" + idCancion</code> dentro de <code>Assets/Resources/Audios/</code>, e <code>IniciarPractica</code> construye el archivo MIDI como <code>cancionSeleccionada + "_" + sufijoMano + ".mid"</code>. Si cambias este formato en el código sin renombrar tus archivos, las canciones no cargarán.</div>

<h3>3.4 Métodos y Funciones de <code>GestorMenu</code></h3>

<h4>1. Navegación de Menús y Selección de Canción</h4>
<pre>
void Start()
{
    MostrarMenuPrincipal();
}

public void MostrarMenuPrincipal()
{
    panelMenuPrincipal.SetActive(true);
    panelSeleccionCanciones.SetActive(false);
    panelJuegoAR.SetActive(false);

    reproductorAudio.Stop();
    cancionSeleccionada = "";
}

public void MostrarSeleccionCanciones()
{
    panelMenuPrincipal.SetActive(false);
    panelSeleccionCanciones.SetActive(true);
    panelJuegoAR.SetActive(false);

    contenedorOpcionesMano.SetActive(false);
    textoTituloCancion.text = "Selecciona una pista para escucharla";
}

public void SeleccionarCancion(string idCancion)
{
    cancionSeleccionada = idCancion;

    contenedorOpcionesMano.SetActive(true);
    textoTituloCancion.text = "Practicando: " + idCancion;

    AudioClip clipPreview = Resources.Load&lt;AudioClip&gt;("Audios/" + idCancion);

    if (clipPreview != null)
    {
        reproductorAudio.Stop();
        reproductorAudio.clip = clipPreview;
        reproductorAudio.pitch = 1f;
        reproductorAudio.Play();
    }
    else
    {
        Debug.LogWarning("No se encontró el audio de preview para: " + idCancion + ". Revisa la carpeta Resources/Audios.");
    }
}
</pre>
<ul>
    <li><strong><code>MostrarMenuPrincipal()</code> y <code>MostrarSeleccionCanciones()</code></strong>: Alternan la visibilidad de los paneles principales y reinician el estado de selección.</li>
    <li><strong><code>SeleccionarCancion(string idCancion)</code></strong>: Guarda el ID de la canción, habilita los botones de selección de mano y carga dinámicamente desde <code>Resources/Audios/</code> el clip de audio para reproducir una vista previa a velocidad normal (<code>pitch = 1f</code>).</li>
</ul>

<h4>2. Preparación, Cuenta Regresiva y Control de Práctica</h4>
<pre>
public void IniciarPractica(string sufijoMano)
{
    if (string.IsNullOrEmpty(cancionSeleccionada)) return;

    archivoMidiPendiente = cancionSeleccionada + "_" + sufijoMano + ".mid";

    panelSeleccionCanciones.SetActive(false);
    panelJuegoAR.SetActive(true);

    reproductorAudio.Stop();
    reproductorAudio.time = 0f;

    if (textoCuentaRegresiva != null) textoCuentaRegresiva.gameObject.SetActive(false);
}

public void IniciarCuentaRegresiva()
{
    if (rutinaCuenta != null) StopCoroutine(rutinaCuenta);
    rutinaCuenta = StartCoroutine(RutinaCuenta());
}

private IEnumerator RutinaCuenta()
{
    textoCuentaRegresiva.gameObject.SetActive(true);

    textoCuentaRegresiva.text = "3";
    yield return new WaitForSeconds(1f);

    textoCuentaRegresiva.text = "2";
    yield return new WaitForSeconds(1f);

    textoCuentaRegresiva.text = "1";
    yield return new WaitForSeconds(1f);

    textoCuentaRegresiva.text = "¡A TOCAR!";

    reproductorAudio.Stop();
    reproductorAudio.time = 0f;
    reproductorAudio.Play();
    lectorMidi.IniciarCascada(archivoMidiPendiente);

    yield return new WaitForSeconds(1f);
    textoCuentaRegresiva.gameObject.SetActive(false);
}

public void InterrumpirPractica()
{
    if (rutinaCuenta != null) StopCoroutine(rutinaCuenta);
    if (textoCuentaRegresiva != null) textoCuentaRegresiva.gameObject.SetActive(false);

    reproductorAudio.Stop();
    lectorMidi.DetenerCascada();
}

public void CambiarVelocidadJuego(float multiplicador)
{
    lectorMidi.CambiarVelocidadCaida(multiplicador);
    reproductorAudio.pitch = multiplicador;
}

public void SalirAplicacion()
{
    Application.Quit();
}

public void SalirDeAR()
{
    InterrumpirPractica();
    MostrarMenuPrincipal();
}
</pre>
<ul>
    <li><strong><code>IniciarPractica(string sufijoMano)</code></strong>: Construye el nombre del archivo MIDI (<code>cancionSeleccionada + "_" + sufijoMano + ".mid"</code>), abre el panel AR y detiene el audio en espera de que el usuario fije el marcador AR.</li>
    <li><strong><code>IniciarCuentaRegresiva()</code> / <code>RutinaCuenta()</code></strong>: Cuenta de 3 a 1 segundo por segundo, inicia simultáneamente el <code>AudioSource</code> y <code>lectorMidi.IniciarCascada(archivoMidiPendiente)</code>.</li>
    <li><strong><code>InterrumpirPractica()</code></strong>: Detiene inmediatamente la corrutina de cuenta regresiva, el audio y recicla todas las notas de la cascada.</li>
    <li><strong><code>CambiarVelocidadJuego(float multiplicador)</code></strong>: Ajusta al mismo tiempo la velocidad de caída visual en <code>MidiReaderTest</code> y el <code>pitch</code> del <code>AudioSource</code> para mantener sincronía total entre audio y video.</li>
</ul>

<hr>

<h2>4. Script: <code>MidiReaderTest.cs</code></h2>
<p><strong>Ruta en el proyecto:</strong> <code>Assets/Scripts/MidiReaderTest.cs</code></p>

<h3>4.1 Propósito de la Clase</h3>
<p>Es el núcleo técnico del visualizador de piano. Lee archivos estándar <code>.mid</code> binarios utilizando la biblioteca <strong>Melanchall.DryWetMidi</strong>, extrae el mapa de tempo y la lista de notas con su tiempo de inicio y duración en microsegundos, calcula la posición física exacta sobre un teclado real (distinguiendo teclas blancas y negras/sostenidos a partir del Do central MIDI 60), y administra el ciclo de vida visual de las notas mediante dos colas de reciclaje (<em>Object Pools</em>) para evitar tirones de memoria en dispositivos móviles AR.</p>

<h3>4.2 Subclase Interna: <code>DatosNota</code></h3>
<pre>
private class DatosNota
{
    public float posicionX;      // Posición horizontal en metros respecto al Do central (MIDI 60)
    public float posicionY;      // Altura inicial en metros según el segundo en que debe sonar
    public float alturaNota;     // Largo vertical del bloque en metros según cuánto dura la nota
    public bool esSostenido;     // true si es tecla negra (#/b), false si es tecla blanca
    public bool estaActiva;      // true mientras tiene un GameObject (cubo) visible en escena
    public bool estaTerminada;   // true cuando ya pasó por debajo del teclado y fue reciclada
    public GameObject cuboActivo;// Referencia al objeto 3D prestado del Pool mientras cae
    public string letraNota;     // Nombre en cifrado americano ("C", "C#", "D", etc.)
}
</pre>

